      }
    ],
    "TaskCreated": [
      {
        "type": "command",
        "command": "bash \"$CLAUDE_PROJECT_DIR\"/plugins/cc-teams/hooks/task-created.sh"
      }
    ],
    "TaskCompleted": [
      {
        "type": "command",
        "command": "bash \"$CLAUDE_PROJECT_DIR\"/plugins/cc-teams/hooks/task-completed.sh"
      }
    ],
    "WorktreeCreate": [
      {
        "type": "command",
        "command": "bash \"$CLAUDE_PROJECT_DIR\"/plugins/cc-teams/hooks/worktree-create.sh"
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "bash \"$CLAUDE_PROJECT_DIR\"/plugins/cc-teams/hooks/pre-compact.sh"
      }
